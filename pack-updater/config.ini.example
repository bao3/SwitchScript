# PackUpdater config (sdmc:/switch/PackUpdater/config.ini)
[updater]
repo = bao3/SwitchScript
asset_prefix = NS-SD-Card-Atmosphere-
extract_to = sdmc:/
min_zip_mb = 10
# Cloudflare Worker GitHub file proxy (default). Empty = talk to github.com directly.
gh_proxy = https://gh.heibang.club
# HTTP CONNECT proxy — usually leave empty; Switch in CN should use gh_proxy.
# proxy = http://192.168.50.10:7893
# token =
